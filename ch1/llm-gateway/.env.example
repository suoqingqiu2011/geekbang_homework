# ═══════════════════════════════════════════════════════════
# LLM Gateway — Environment Variables (copy to .env)
# ═══════════════════════════════════════════════════════════

# --- Server ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_WORKERS=4
GATEWAY_LOG_LEVEL=INFO

# --- Config ---
# Path to YAML config; hot-reloaded via file watcher
GATEWAY_CONFIG_FILE=config/gateway.yaml

# --- Storage ---
GATEWAY_DB_PATH=data/metrics.db
GATEWAY_TRACING_TTL=3600.0

# --- Rate limiting defaults ---
GATEWAY_RATE_MODEL=10
GATEWAY_RATE_ENDPOINT=100
GATEWAY_RATE_PROJECT=1000
GATEWAY_RATE_USER=5000

# --- Auth: gateway-level API keys (comma separated) ---
# Dev/test keys only. Rotate in production.
GATEWAY_API_KEYS=sk-gateway-dev,sk-gateway-test

# --- Provider API keys (dynamic config supported) ---
KIMI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_KEY=

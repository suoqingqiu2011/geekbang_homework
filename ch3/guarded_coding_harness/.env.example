# ---------------------------------------------------------------------------
# Guarded Coding Harness - 本地环境变量模板
# ---------------------------------------------------------------------------
# 使用方法：
#   1. 复制本文件为 .env（.env 已被 .gitignore 忽略，不会进入版本库）
#        PowerShell: Copy-Item .env.example .env
#        Bash:       cp .env.example .env
#   2. 填入真实值；脚本只读取进程环境变量，运行前请加载 .env 或直接设置变量
#        Bash:       set -a; source .env; set +a
#        PowerShell: 直接设置 $env:XXX，或由 IDE/终端配置加载
# 切勿把真实 Key 写回本文件；本文件会随仓库提交。
# ---------------------------------------------------------------------------

# DeepSeek OpenAI 兼容接口的 API Key（必填，仅本地填写）
DEEPSEEK_API_KEY=

# 真实模型演示使用的模型 id（可选，默认 deepseek-v4-pro）
HARNESS_REAL_MODEL=deepseek-v4-pro

# OpenAI 兼容 API base（可选）
HARNESS_REAL_BASE=https://api.deepseek.com/v1
